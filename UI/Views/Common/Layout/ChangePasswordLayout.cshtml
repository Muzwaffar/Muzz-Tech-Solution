@using BL.Models.Administration;
@model ChangePasswordDTO;

<div id="ChangePassword-Panel">
    <div class="">

        <h6 class="ms-4 mb-0">Please enter a new password and confirm</h6>

        @*New Password*@
        <div class="form-floating long-input">
            @Html.TextBoxFor(m => m.NewPassword, new { @class="form-control input-floating",@result="NewPassword", @id = "NewPassword", @type = "password", @placeholder = "New Password", onfocusout="Validation.password($(event.target))"})
            <i id="password-new-show-hide" class="fa fa-eye password-show-hide" onclick="LayoutCustomLogin.togglePasswordVisibility($(this),'NewPassword')"></i>
            <label class="label-floating">New Password</label>
        </div>

        <div class="ms-4">
            <p class="span-small m-0"> Please ensure that your password contains</p>
            <p class="span-small m-0">- a minimum of 8 alphanumeric characters </p>
            <p class="span-small m-0">- at least 1 Upper case character </p>
            <p class="span-small m-0">- at least 1 Lower case character and </p>
            <p class="span-small m-0">- at least 1 special character, for e.g !, #, $, %, ... </p>

        </div>

        @*Confirm Password*@
        <div class="form-floating long-input">
            @Html.TextBoxFor(m => m.ConfirmPassword, new { @class="form-control input-floating",@result="ConfirmPassword", @id = "confirmpassword", @type = "password", @placeholder = "Confirm Password" })
            <i id="password-confirm-show-hide" class="fa fa-eye password-show-hide" onclick="LayoutCustomLogin.togglePasswordVisibility($(this),'confirmpassword')"></i>
            <label class="label-floating">Confirm Password</label>
        </div>

    </div>

    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 pe-4 row">
            <button id="changepassword-save-btn" title="Save" onclick="LayoutCustomLogin.changePassword()" class="form-control btn-c-primary"><i class="fa fa-save me-2"></i>Save</button>
        </div>
    </div>
</div>

