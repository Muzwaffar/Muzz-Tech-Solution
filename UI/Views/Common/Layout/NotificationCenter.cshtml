
<div class="offcanvas offcanvas-end" tabindex="-1" id="notification-container" aria-labelledby="notification">
    <div class="naveo-color-grey offcanvas-header p-4 pb-0">
        <h5 class="offcanvas-title" id="notification"><i class="fa-regular fa-bell fa-1x me-2"></i>Notification</h5>
        <audio class="d-none" id="notif-sound-container">
            <source src="~/assets/Sound/NotificationSound.wav" type="audio/mpeg">
        </audio>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="nav nav-tabs nav-justified mb-4" id="notification-tab-control" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="today-tab" data-bs-toggle="tab" data-bs-target="#notification-today" type="button" role="tab" aria-controls="today" aria-selected="true">Today</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="last-7-days-tab" data-bs-toggle="tab" data-bs-target="#notification-last-7-days" type="button" role="tab" aria-controls="last-7-days" aria-selected="false">Last 7 Days</button>
            </li>
        </ul>
        <div class="tab-content" id="notification-pane">
            <div class="tab-pane fade show active" id="notification-today" role="tabpanel" aria-labelledby="today-tab">
                <div class="f-weight-bold p-2 text-center bg-grey mb-3">
                    <span> Unread </span>
                </div>
                <ul class="list-group list-group-flush" id="list-events-unread">
                </ul>
                <div class="f-weight-bold p-2 text-center bg-grey">
                    <span> Read </span>
                </div>
                <ul class="list-group list-group-flush" id="list-events-read">
                </ul>
            </div>
            <div class="tab-pane fade" id="notification-last-7-days" role="tabpanel" aria-labelledby="last-7-days-tab">
                <ul class="list-group list-group-flush" id="list-events-last-7-days">
                   
                </ul>
            </div>
        </div>
    </div>
</div>