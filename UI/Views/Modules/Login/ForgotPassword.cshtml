@{
    ViewData["Title"] = "ForgotPassword";
    Layout = "~/Views/Shared/_LayoutNoNavbarSidemenu.cshtml";
}

@section CSS{
    <link rel="stylesheet" href="~/css/Modules/Login/LoginPanel.css" />
}

    <div id="forgotpassword-panel" class="row">
        <div class="col-md-6">
        <div class="login-header d-flex mt-2 mx-3">
            <img class="loginLogo" src="~/assets/Common/Logo/crms-logo.png" />
            </div>
            <div class="login-body input-group">
                <div class="login-form">
                    <div class="text-center">
                        <h2 class="mb-3">Forgot Password</h2>
                        <p class="my-2 f-weight-regular">Instructions to change your password will be sent to you.</p>
                        <p class="f-weight-regular">Please enter a valid email address.</p>
                    </div>

                    <div class="w-75 m-5">
                        <label class="login-label mb-1">Email Address</label>
                        <input required result="email" type="text" class="form-control login-input" />
                    </div>

                    <div class="d-flex justify-content-around my-4">
                        <button class="form-control btn-c-secondary" onclick="Login.back()">
                            Cancel
                        </button>
                    <button class="form-control  btn-c-primary" id="submitButton" onclick="Login.forgotPassword()">
                            Submit
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6" id="login-img-panel">
        </div>

    </div>

    @section Scripts{
    <script src="~/Scripts/Modules/Login/Login.js" type="module"></script>
}