    <button id="value-save-btn" title="Save" onclick="LivestockControlBook.save()" class="form-control noView btn-c-primary me-3"><i class="fa fa-save me-2"></i>Save</button>
</div> *@

@section Scripts {
    <script src="~/Scripts/Modules/Store/StoreTransaction/StoreTransaction.js" type="module"></script>
}
