@*Actions*@
<div class="row action-bar">

    <button id="back-btn" title="Back" onclick="CallHandling.back()" class="form-control btn-c-error me-3"><i class="fa fa-chevron-left me-2"></i>Back</button>
    @if (Model.Status != DAL.Common.TransactionStatus.Completed)
    {
        if (Model.Status != DAL.Common.TransactionStatus.Abort)
        {
            <button id="abort-btn" title="Abort" onclick="CallHandling.abort()" class="form-control btn-c-error me-3"><i class="fa-solid fa-ban me-2"></i>Abort</button>
            <button id="complete-btn" title="Complete" onclick="CallHandling.complete()" class="form-control btn-c-secondary me-3"><i class="fa-solid fa-check-double me-2"></i>Complete</button>
            @if (Model.HasAckowledge == true)
            {
                <button id="acknowledge-btn" title="Acknowledge" onclick="CallHandling.acknowledge()" class="form-control btn-c-primary me-3"><i class="fa fa-sync me-2"></i>Acknowledge</button>
            }
            @if (Model.Status == DAL.Common.TransactionStatus.Submitted)
            {
                <button id="assign-btn" title="Assign" onclick="CallHandling.assign()" class="form-control btn-c-secondary me-3"><i class="fa fa-save me-2"></i>Assign</button>
            }
            @if (Model.Status != DAL.Common.TransactionStatus.Submitted)
            {
                <button id="save-btn" title="Save" onclick="CallHandling.save()" class="form-control noView btn-c-primary me-3"><i class="fa fa-save me-2"></i>Submit</button>
            }

        }
        else
        {
            <span class="d-flex f-weight-black me-3 min naveo-color-red span-large w-min-content" style="">Aborted</span>
        }

    }
    else
    {
        <span class="d-flex f-weight-black me-3 min naveo-color-green span-large w-min-content" style="">Completed</span>
    }
</div>

@section Scripts {
    <script src="~/Scripts/Modules/Transaction/CallHandling/CallHandling.js" type="module"></script>
}
