@{
    ViewData["Title"] = @ViewBag.Name;
    Layout = "~/Views/Shared/_LayoutCustom.cshtml";
}

@*Model Used *@
@using BL.Models.Form;
@model FormSectionAndElementModuleMappingCRUDTO;

@*Top nav bar Start*@
<div id="">
    @*Top nav bar Container*@
    <div class="breadcrumb-container d-flex">
        @*Breadcrumb - Left *@
        <div class="breadcrumb-sub-container">
            @*Breadcrumb : Text *@
            <span class="span-larger"> @ViewBag.Name </span>
            @*Breadcrumb : Action *@
            <a href="#" role="button" aria-expanded="false"><i class="fa fa-ellipsis-vertical fa-20 ms-2"></i></a>
            @*Breadcrumb : Dropdown *@
            <div class="dropdown-context">
            </div>
        </div>
        @*Section - Right *@
        <div class="section-container d-flex">
            @*Section Nav : container *@
            <nav>
                <div class="nav nav-pill" id="nav-tab" role="tablist">
                    @*Section Nav Item: Form Info *@
                    @*IMPORTANT : id  ,target, controls, active class *@
                    <button class="nav-link active section-menu" id="FormPageSEMapping-tab" data-bs-toggle="pill" data-bs-target="#details-FormPageSEMapping" type="button" role="tab" aria-controls="details-FormPageSEMapping" aria-selected="true">
                        <span class="span-medium">
                            @*Section Item: Icon for Status *@
                            <i class="fa fa-circle-dot me-2"></i>
                            @*Section Item: Text *@
                            General Information
                        </span>
                    </button>

                </div>
            </nav>
        </div>
    </div>
</div>
@*Top nav bar End*@

@*Main Container Start*@
@*IMPORTANT : id to retrieve data to send to api  *@
<div class="tab-content " id="section-element-mapping">
    @*Main Container scrollspy : Form Info*@
    <div class="tab-pane fade show active" id="details-FormPageSEMapping" role="tabpanel" aria-labelledby="FormPageSEMapping-tab">
        @*scrollspy*@
        <div class="row content-scrollspy">
            @*scrollspy content*@
            <div class="col-10 content-form">
                <div id="AddEdit-Panel" class="content-panel" data-bs-spy="scroll" data-bs-target="#scrollspy-menu-Form" data-bs-offset="0" data-bs-smooth-scroll="true" tabindex="0">
                    @*scrollspy sub section*@
                    <div id="scrollspy-details" class="scrollspy-transition">
                        @*sub section Header*@
                        <div class="section" data-bs-toggle="collapse" href="#details" aria-expanded="true">
                            <span class="span-medium"> Form </span>
                            <span class="collapsible-icon"></span>
                        </div>
                        @*sub section Content*@
                        <div class="collapse form-panel show" id="details">

                            @*Form*@
                            <div class="form-floating">
                                @Html.HiddenFor(m => m.Form, new { @id = "select-FormId-id" })
                                <select class="form-select" id="select-FormId" name="Form" result="Form">
                                    <option value=""></option>
                                </select>
                                <label for="select-FormId" class="label-required">Form</label>
                            </div>

                            @*Module Name*@
                            <div class="form-floating">
                                @Html.HiddenFor(m => m.Module, new { @id = "select-ModuleId-id" })
                                <select class="form-select" id="select-ModuleId" name="ModuleId" result="ModuleId">
                                    <option value=""></option>
                                </select>
                                <label for="select-ModuleId" class="label-required">Module Name</label>
                            </div>

                        </div>
                    </div>

                    <div id="scrollspy-Element" class="scrollspy-transition d-none">
                        @*sub section Header*@
                        <div class="section" data-bs-toggle="collapse" href="#Element" aria-expanded="true">
                            <span class="span-medium"> Element </span>
                            <span class="collapsible-icon"></span>
                        </div>
                        @*sub section Content*@
                        <div class="collapse form-panel show" id="Element">

                            @*Element*@
                            <div class="form-floating">
                                <select class="form-select" id="select-element" name="element">
                                    <option value=""></option>
                                </select>
                                <label for="select-element">Element</label>
                            </div>

                            @*ReadOnly*@
                            <div class="form-floating">
                                <input type="checkbox" class="form-control" IsListing="ReadOnly" id="ReadOnly" placeholder="Value" />
                                <label class="label-checkbox">ReadOnly</label>
                            </div>

                            @*Add Data To Table*@
                            <button id="value-addT-btn" title="Add" onclick="FormSectionAndElementModuleMappingAddEdit.addDataElement()" class="btn-c-primary form-control mt-4 w-100"><i class="fa fa-plus me-2"></i>Add Data To Table</button>

                            @*Element Table*@
                            <div class="w-100">
                                <table id="ElementTable"></table>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
            @*scrollspy action*@
            <div class="col-2 scrollspy-con scrollspy" id="scrollspy-menu-Form">
                @*scrollspy action : Header*@
                <span class="naveo-color m-3"> Sections</span>
                @*scrollspy actions content*@
                <div class="scrollspy-content">
                    @*scrollspy actions item*@
                    <div class="m-3">
                        <a href="#scrollspy-details">
                            <span class="span-medium">Form</span>
                        </a>
                    </div>
                    @*scrollspy actions item*@
                    <div class="m-3 d-none" id="section-element">
                        <a href="#scrollspy-Element">
                            <span class="span-medium">Element</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*Main Container End*@

@*Actions*@
<div class="row action-bar">
    <button id="value-back-btn" title="Back" onclick="FormSectionAndElementModuleMappingAddEdit.back()" class="form-control btn-c-error me-3"><i class="fa fa-chevron-left me-2"></i>Back</button>
    <button id="value-save-btn" title="Save" onclick="FormSectionAndElementModuleMappingAddEdit.save()" class="form-control noView btn-c-primary me-3"><i class="fa fa-save me-2"></i>Save</button>

</div>

@section Scripts {
    <script src="~/Scripts/Modules/Form/FormConfig/FormSectionAndElementModuleMapping/FormSectionAndElementModuleMappingAddEdit.js" type="module"></script>
}