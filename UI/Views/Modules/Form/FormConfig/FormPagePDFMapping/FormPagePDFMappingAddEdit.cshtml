@{
    ViewData["Title"] = @ViewBag.Name;
    Layout = "~/Views/Shared/_LayoutCustom.cshtml";
}

@*Model Used *@
@using BL.Models.Template;
@model TemplateFormMappingCRUDTO;

@*Top nav bar Start*@
<div id="">
    @*Top nav bar Container*@
    <div class="breadcrumb-container d-flex">
        @*Breadcrumb - Left *@
        <div class="breadcrumb-sub-container">
            @*Breadcrumb : Text *@
            <span class="span-larger"> @ViewBag.Name </span>
            @*Breadcrumb : Action *@
            <a href="#" role="button" aria-expanded="false"><i class="fa fa-ellipsis-vertical fa-20 ms-2"></i></a>
            @*Breadcrumb : Dropdown *@
            <div class="dropdown-context">
            </div>
        </div>
        @*Section - Right *@
        <div class="section-container d-flex">
            @*Section Nav : container *@
            <nav>
                <div class="nav nav-pill" id="nav-tab" role="tablist">
                    @*Section Nav Item: Form Info *@
                    @*IMPORTANT : id  ,target, controls, active class *@
                    <button class="nav-link active section-menu" id="FormPagePDFMapping-tab" data-bs-toggle="pill" data-bs-target="#details-FormPagePDFMapping" type="button" role="tab" aria-controls="details-FormPagePDFMapping" aria-selected="true">
                        <span class="span-medium">
                            @*Section Item: Icon for Status *@
                            <i class="fa fa-circle-dot me-2"></i>
                            @*Section Item: Text *@
                            General Information
                        </span>
                    </button>

                </div>
            </nav>
        </div>
    </div>
</div>
@*Top nav bar End*@

@*Main Container Start*@
@*IMPORTANT : id to retrieve data to send to api  *@
<div class="tab-content " id="template-form-mapping">
    @*Main Container scrollspy : Form Info*@
    <div class="tab-pane fade show active" id="details-FormPagePDFMapping" role="tabpanel" aria-labelledby="FormPagePDFMapping-tab">
        @*scrollspy*@
        <div class="row content-scrollspy">
            @*scrollspy content*@
            <div class="col-10 content-form">
                <div id="AddEdit-Panel" class="content-panel" data-bs-spy="scroll" data-bs-target="#scrollspy-menu-Form" data-bs-offset="0" data-bs-smooth-scroll="true" tabindex="0">
                    @*scrollspy sub section*@
                    <div id="scrollspy-details" class="scrollspy-transition">
                        @*sub section Header*@
                        <div class="section" data-bs-toggle="collapse" href="#details" aria-expanded="true">
                            <span class="span-medium"> Form </span>
                            <span class="collapsible-icon"></span>
                        </div>
                        @*sub section Content*@
                        <div class="collapse form-panel show" id="details">

                            @*Form*@
                            <div class="form-floating">
                                @Html.HiddenFor(m => m.FormId, new { @id = "select-FormId-id" })
                                <select class="form-select" id="select-FormId" name="FormId" result="FormId">
                                    <option value=""></option>
                                </select>
                                <label for="select-FormId" class="label-required">Form</label>
                            </div>

                            @*Module Name*@
                            <div class="form-floating">
                                @Html.HiddenFor(m => m.ModuleId, new { @id = "select-ModuleId-id" })
                                <select class="form-select" id="select-ModuleId" name="ModuleId" result="ModuleId">
                                    <option value=""></option>
                                </select>
                                <label for="select-ModuleId" class="label-required">Module Name</label>
                            </div>

                            @*TemplateName*@
                            <div class="form-floating d-none">
                                @Html.TextBoxFor(m => m.TemplateName, new { @class = "form-control", @id = "TemplateName", @type = "text", @placeholder = "TemplateName" })
                                <label>Code</label>
                            </div>

                            @*Template Name*@
                            <div class="form-floating">
                                <select class="form-select" id="select-TemplateName" name="TemplateName" result="TemplateName">
                                    <option value=""></option>
                                </select>
                                <label for="select-TemplateName" class="label-required">Template Name</label>
                            </div>

                            @*Attachment*@
                            <div class="w-100 m-4">
                                <input class="form-control p-3" type="file" id="reports" onchange="FormPagePDFMappingAddEdit.validateFileType()">
                                <span class="naveo-color span-smaller">Accepted file extensions: .pdf</span>
                            </div>

                        </div>
                    </div>

                    <div id="scrollspy-Element" class="scrollspy-transition d-none">
                        @*sub section Header*@
                        <div class="section" data-bs-toggle="collapse" href="#Element" aria-expanded="true">
                            <span class="span-medium"> Element </span>
                            <span class="collapsible-icon"></span>
                        </div>
                        @*sub section Content*@
                        <div class="collapse form-panel show" id="Element">
                            @*Section*@
                            <div class="form-floating">
                                <select class="form-select" id="select-section" name="section">
                                    <option value=""></option>
                                </select>
                                <label for="select-section">Section</label>
                            </div>

                            @*Element*@
                            <div class="form-floating">
                                <select class="form-select" id="select-element" name="element">
                                    <option value=""></option>
                                </select>
                                <label for="select-element">Element</label>
                            </div>

                            @*ElementType*@
                            <div class="form-floating">
                                <select class="form-select" id="select-element-type" name="element-type">
                                    <option value=""></option>
                                </select>
                                <label for="select-element-type">Element Type</label>
                            </div>

                            @*ParentId *@
                            <div class="form-floating d-none" id="FieldparentId">
                                <input type="number" class="form-control" id="parentId" placeholder="ParentId" />
                                <label>ParentId</label>
                            </div>

                            @*Row *@
                            <div class="form-floating d-none" id="Fieldrow">
                                <input type="number" class="form-control" id="row" placeholder="Row" />
                                <label>Row</label>
                            </div>

                            @*Column*@
                            <div class="form-floating d-none" id="Fieldcolumn">
                                <input type="text" class="form-control" id="column" placeholder="Column" />
                                <label>Column</label>
                            </div>

                            @*TemplateText*@
                            <div class="form-floating">
                                <select class="form-select" id="select-template-text" name="template-text">
                                    <option value=""></option>
                                </select>
                                <label for="select-template-text">Template Text</label>
                            </div>

                            @*Add Data To Table*@
                            <button id="value-addT-btn" title="Add" onclick="FormPagePDFMappingAddEdit.addDataElement()" class="btn-c-primary form-control mt-4 w-100"><i class="fa fa-plus me-2"></i>Add Data To Table</button>

                            @*Element Table*@
                            <div class="w-100">
                                <table id="ElementTable"></table>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
            @*scrollspy action*@
            <div class="col-2 scrollspy-con scrollspy" id="scrollspy-menu-Form">
                @*scrollspy action : Header*@
                <span class="naveo-color m-3"> Sections</span>
                @*scrollspy actions content*@
                <div class="scrollspy-content">
                    @*scrollspy actions item*@
                    <div class="m-3">
                        <a href="#scrollspy-details">
                            <span class="span-medium">Form</span>
                        </a>
                    </div>
                    @*scrollspy actions item*@
                    <div class="m-3 d-none" id="section-element">
                        <a href="#scrollspy-Element">
                            <span class="span-medium">Element</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*Main Container End*@

@*Actions*@
<div class="row action-bar">
    <button id="value-back-btn" title="Back" onclick="FormPagePDFMappingAddEdit.back()" class="form-control btn-c-error me-3"><i class="fa fa-chevron-left me-2"></i>Back</button>
    <button id="value-save-btn" title="Save" onclick="FormPagePDFMappingAddEdit.save()" class="form-control noView btn-c-primary me-3"><i class="fa fa-save me-2"></i>Save</button>
    
</div>

@section Scripts {
    <script src="~/Scripts/Modules/Form/FormConfig/FormPagePDFMapping/FormPagePDFMappingAddEdit.js" type="module"></script>
}