@{
    Layout = "~/Views/Shared/_LayoutCustom.cshtml";
    ViewData["Title"] = @ViewBag.Name;
}

@*Main Container*@
<div id="">
    @*Breadcrumb*@
    <div class="breadcrumb-container d-flex">
        <div class="breadcrumb-sub-container">
            <span class="span-larger"><i class="fa fa-users-gear me-2 fa-1x"></i> @ViewBag.Name </span>
            <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa fa-ellipsis-vertical fa-20 ms-2"></i></a>
            <div class="dropdown-context">
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" onclick="CallerList.export()">Export Excel</a></li>
                </ul>
            </div>

        </div>
        <div class="section-container d-flex">
        </div>
    </div>

    @*Datatable*@
    <table id="CallerTable"></table>

</div>

@*References*@
@section Scripts{
    <script src="~/Scripts/Modules/Administration/General/Caller/CallerList.js" type="module"></script>
}
