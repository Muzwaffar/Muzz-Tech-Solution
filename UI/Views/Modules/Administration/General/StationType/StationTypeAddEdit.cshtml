@using BL.Models.Administration;
@model StationTypeDTO;

<div id="StationType-AddEdit-Panel">
    <div class="form-panel">

        @*Station Type Id HIDDEN*@
        <div class="form-floating d-none">
            <span></span>
            @Html.TextBoxFor(m => m.Id, new { @class="form-control",@result="Id", @id = "Id", @type = "text", @placeholder = "Id"})
        </div>

        @*Station Type Code*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Code, new { @class="form-control",@result="Code", @id = "Code", @type = "text", @placeholder = "Resource Type Code" , @readonly="true"})
            <label class="label-floating">Code</label>
        </div>

        @*Station Type Name*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Name, new { @class="form-control",@result="Name", @id = "Name", @type = "text", @placeholder = "Name" ,@required  = "required"})
            <label class="label-floating label-required">Station Type Name</label>
        </div>

        @*Station Type Description*@
        <div class="form-floating">
            @Html.TextAreaFor(m => m.Description, new { @class="form-control",@result="Description", @id = "TypeDesc", @type = "text", @placeholder = "Description" })
            <label class="label-floating">Description</label>
        </div>
    </div>

    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 pe-5 row">
            <button id="value-save-btn" title="Save" onclick="StationTypeAddEdit.saveUpdate()" class="form-control noView btn-c-primary"><i class="fa fa-save me-2"></i>Save</button>
        </div>
    </div>
</div>
