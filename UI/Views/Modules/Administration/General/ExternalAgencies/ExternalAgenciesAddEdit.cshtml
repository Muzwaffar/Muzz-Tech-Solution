@using BL.Models.Administration;
@model ExternalAgenciesCRUDDTO;

<div id="ExternalAgency-AddEdit-Panel">
    <div class="form-panel">

        @*External Agency Id HIDDEN*@
        <div class="form-floating d-none">
            @Html.TextBoxFor(m => m.Id, new { @class="form-control",@result="Id", @id = "Id", @type = "text", @placeholder = "Id"})
        </div>

        @*External Agency Code*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Code, new { @class="form-control",@result="Code", @id = "Code", @type = "text", @placeholder = "Code" , @readonly="true"})
            <label class="label-floating">Code</label>
        </div>

        @*External Agency Name*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Name, new { @class="form-control",@result="Name", @id = "Name", @type = "text", @placeholder = "Name" ,@required  = "required"})
            <label class="label-floating label-required">Agency Name</label>
        </div>

        @*External Agency Description*@
        <div class="form-floating">
            @Html.TextAreaFor(m => m.Description, new { @class="form-control",@result="Description", @id = "Description", @type = "text", @placeholder = "Description" })
            <label class="label-floating">Agency Description</label>
        </div>
        @*External Agency ContactNumber*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.ContactNumber, new { @class="form-control",@result="ContactNumber", @id = "ContactNumber", @type = "text", @placeholder = "Contact Number",@required  = "required"})
            <label class="label-floating label-required">Contact Number</label>
        </div>

    </div>

    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 pe-5 row">
            <button id="value-save-btn" title="Save" onclick="ExternalAgenciesAddEdit.saveUpdate()" class="form-control noView btn-c-primary"><i class="fa fa-save me-2"></i>Save</button>
        </div>
    </div>
</div>
