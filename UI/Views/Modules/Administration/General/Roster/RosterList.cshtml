@{
    Layout = "~/Views/Shared/_LayoutCustom.cshtml";
    //ViewData["Title"] = "Roster";
    ViewData["Title"] = @ViewBag.Name;
}

@*References Styles*@
@section CSS{
    <link rel="stylesheet" href="~/css/Modules/Administration/Roster/roster.css" asp-append-version="true" />
}

@using System.Globalization;
@using BL.Models.Administration;
@model RosterDTO;

<div id="">
    @*Breadcrumb*@
    <div class="breadcrumb-container d-flex">
        <div class="breadcrumb-sub-container">
            <span class="span-larger"><i class="fa fa-draw-polygon me-2 fa-1x"></i> Roster</span>
            <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa fa-ellipsis-vertical fa-20 ms-2"></i></a>
            <div class="dropdown-context">
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" onclick="shift.export()">Export Excel</a></li>
                </ul>
            </div>

        </div>
        <div class="section-container d-flex">
        </div>
    </div>

    @*Datatable*@
    <table id="RosterTable"></table>

</div>



@*Partial View*@
<div id="partial" class="overlay">
    <div class="popup">
        <div class="title">
            <span class="span-large"><i class="fa fa fa-business-time me-2"></i>Roster</span>
            <a class="close" href="#"><i class="fa fa-close"></i></a>
        </div>
        <div class="content">
        </div>
    </div>
</div>

@*References*@
@section Scripts{
    <script src="~/Scripts/Modules/Administration/General/Roster/Roster.js" type="module"></script>
}
