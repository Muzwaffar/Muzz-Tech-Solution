@using DAL.Models.Administration;
@model NPF_SYS_UomDetails;

<div id="UomDetails-AddEdit-Panel">
    <div class="form-panel">

        @*Id HIDDEN*@
        <div class="form-floating d-none">
            @Html.TextBoxFor(m => m.Id, new { @class="form-control",@result="Id", @id = "Id", @type = "number", @placeholder = "Id"})
        </div>

        @*Name*@
        <div class="form-floating short-input">
            @Html.TextBoxFor(m => m.Name, new { @class="form-control",@result="Name", @id = "detailsName", @type = "text", @placeholder = "Name" ,@required  = "required"})
            <label class="label-floating label-required">Name</label>
        </div>

        @*UOM header*@
        <div class="form-floating">
            @Html.HiddenFor(m => m.UomHeader.Id, new {@id = "select-uomheader-id"})
            <select class="form-select" id="select-uomheader" name="UomHeader" UomHeader="Id">
                <option value=""></option>
            </select>
            <label for="select-uomheader" class="label-required">Unit of Measure Header</label>
        </div>

        @*Unit*@
        <div class="form-floating short-input">
            @Html.TextBoxFor(m => m.Unit, new { @class="form-control",@result="Unit", @id = "detailsUnit", @type = "text", @placeholder = "Unit" ,@required  = "required"})
            <label class="label-floating label-required">Unit</label>
        </div>

        @*Relative factor*@
        <div class="form-floating short-input">
            @Html.TextBoxFor(m => m.RelativeFactor, new { @class="form-control",@result="RelativeFactor", @id = "detailsRF", @type = "number", @placeholder = "Relative Factor" ,@required  = "required"})
            <label class="label-floating label-required">Relative Factor</label>
        </div>

        @*CheckBox*@
        <div class="form-floating">
            @Html.CheckBoxFor(m => m.IsSystemInternational, new { @class="form-control",@result="IsSystemInternational", @id = "IsSystemInternational", @type = "checkbox", @placeholder = "IsSystemInternational"})
            <label class="label-checkbox">Is System International</label>
        </div>
    </div>

    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 pe-5 row">
            <button id="type-save-btn" title="Save" onclick="UomDetailsAddEdit.saveUpdate()" class="form-control noView btn-c-primary"><i class="fa fa-save me-2"></i>Save</button>
        </div>
    </div>
</div>
