@using BL.Models.Administration;
@model ResourceTypeCRUDDTO;

<div id="ResourceType-AddEdit-Panel">
    <div class="form-panel">

        @*Resource Type Id HIDDEN*@
        <div class="form-floating d-none">
            @Html.TextBoxFor(m => m.Id, new { @class="form-control",@result="Id", @id = "Id", @type = "text", @placeholder = "Id"})
        </div>

        @*Resource Type Code*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Code, new { @class="form-control",@result="Code", @id = "Code", @type = "text", @placeholder = "Code" , @readonly="true"})
            <label class="label-floating">Code</label>
        </div>

        @*Resource Type Name*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Name, new { @class="form-control",@result="Name", @id = "Name", @type = "text", @placeholder = "Name" ,@required  = "required"})
            <label class="label-floating label-required">Name</label>
        </div>

        @*Resource Type Description*@
        <div class="form-floating">
            @Html.TextAreaFor(m => m.Description, new { @class="form-control",@result="Description", @id = "Description", @type = "text", @placeholder = "Description"} )
            <label class="label-floating">Description</label>
        </div>

        @*Resource Type Ignore Station*@
        <div class="form-floating">
            @Html.CheckBoxFor(m => m.IgnoreStation, new { @class = "form-control", @result = "IgnoreStation", @id = "IgnoreStation", @type = "checkbox", @placeholder = "CheckBox" })
            <label class="label-checkbox">Ignore Station?</label>
        </div>

        @*Resource Type IsSytem ReadOnly HIDDEN*@
        <div class="form-floating d-none">
            @Html.CheckBoxFor(m => m.IsSystem, new { @class="form-control",@result="IsSystem", @id = "IsSystem", @type = "checkbox", @placeholder = "CheckBox", @disabled = "disabled"})
            <label class="label-checkbox">Is System?</label>
        </div>
    </div>

    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 pe-5 row">
            <button id="value-save-btn" title="Save" onclick="ResourceTypeAddEdit.saveUpdate()" class="form-control noView btn-c-primary"><i class="fa fa-save me-2"></i>Save</button>
        </div>
    </div>
</div>
