@using DAL.Models.Administration;
@model NPF_SYS_LookUpType;

<div id="LookupType-AddEdit-Panel">
    <div class="form-panel">

        @*Lookup Type Id HIDDEN*@
        <div class="form-floating d-none">
            @Html.TextBoxFor(m => m.Id, new { @class="form-control",@result="Id", @id = "Id", @type = "number", @placeholder = "Id"})
        </div>

        @*Lookup Type Name*@
        <div class="form-floating short-input">
            @Html.TextBoxFor(m => m.Name, new { @class="form-control",@result="Name", @id = "typeName", @type = "text", @placeholder = "Name" ,@required  = "required"})
            <label class="label-floating label-required">Name</label>
        </div>

        @*Lookup Type Description*@
        <div class="form-floating short-input">
            @Html.TextAreaFor(m => m.Description, new { @class="form-control",@result="Description", @id = "typeDesc", @type = "text", @placeholder = "Description" })
            <label class="label-textarea-floating">Description</label>
        </div>


    </div>

    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 row p-pop-btn">
            <button id="type-save-btn" title="Save" onclick="LookupTypeAddEdit.saveUpdate()" class="form-control noView btn-c-primary"><i class="fa fa-save me-2"></i>Save</button>
        </div>
    </div>
</div>
