@using BL.Models.Administration;
@model RankDTO;

<div id="Rank-AddEdit-Panel">
    <div class="form-panel">

        @*Rank Id HIDDEN*@
        <div class="form-floating d-none">
            <span></span>
            @Html.TextBoxFor(m => m.Id, new { @class="form-control",@result="Id", @id = "Id", @type = "text", @placeholder = "Id"})
        </div>

        @*Rank Code*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Code, new { @class="form-control",@result="Code", @id = "Code", @type = "text", @placeholder = "Resource Type Code" , @readonly="true"})
            <label class="label-floating">Code</label>
        </div>

        @*Rank Name*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Name, new { @class="form-control",@result="Name", @id = "Name", @type = "text", @placeholder = "Name" ,@required  = "required"})
            <label class="label-floating label-required">Rank</label>
        </div>

        @*Rank Description*@
        <div class="form-floating">
            @Html.TextAreaFor(m => m.Description, new { @class="form-control",@result="Description", @id = "TypeDesc", @type = "text", @placeholder = "Description" })
            <label class="label-floating">Description</label>
        </div>

        @*Resource Category*@
        <div class="form-floating">
            @Html.HiddenFor(m => m.ResourceCategory, new { @id = "select-resourceCategory-id" })
            <select class="form-select" id="select-resourceCategory" name="ResourceCategory" result="ResourceCategory">
                <option value=""></option>
            </select>
            <label for="select-resourceCategory" class="label-required"> Resource Category </label>
        </div>

        @*Rank Order*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Order, new { @class = "form-control", @result = "Order", @id = "Order", @type = "number", @placeholder = "Order" })
            <label class="label-floating">Order</label>
        </div>

    </div>
    </div>

    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 pe-5 row">
            <button id="value-save-btn" title="Save" onclick="RankAddEdit.saveUpdate()" class="form-control noView btn-c-primary"><i class="fa fa-save me-2"></i>Save</button>
        </div>
    </div>
</div>
