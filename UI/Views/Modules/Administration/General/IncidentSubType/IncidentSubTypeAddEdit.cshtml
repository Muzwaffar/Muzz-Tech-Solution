@using BL.Models.Administration;
@model IncidentSubTypeDTO;

<div id="IncidentSubType-AddEdit-Panel">
    <div class="form-panel">

        @*Incident SubType Id HIDDEN*@
        <div class="form-floating d-none">
            <span></span>
            @Html.TextBoxFor(m => m.Id, new { @class="form-control",@result="Id", @id = "Id", @type = "text", @placeholder = "Id"})
        </div>

        @*Incident SubType Code*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Code, new { @class="form-control",@result="Code", @id = "Code", @type = "text", @placeholder = "Resource Type Code" , @readonly="true"})
            <label class="label-floating">Code</label>
        </div>

        @*Incident SubType Name*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Name, new { @class="form-control",@result="Name", @id = "Name", @type = "text", @placeholder = "Name" ,@required  = "required"})
            <label class="label-floating label-required">Incident Sub Type Name</label>
        </div>

        @*Incident Type*@
        <div class="form-floating">
            @Html.HiddenFor(m => m.IncidentType, new {@id = "select-incidenttype-id"})
            <select class="form-select" id="select-incidenttype" name="Id" Result="IncidentType">
                <option value=""></option>
            </select>
            <label for="select-incidenttype" class="label-required">Incident Type</label>
        </div>

        @*Incident SubType Description*@
        <div class="form-floating">
            @Html.TextAreaFor(m => m.Description, new { @class="form-control",@result="Description", @id = "resourceTypeDesc", @type = "text", @placeholder = "Description" })
            <label class="label-floating">Description</label>
        </div>
    </div>
    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 row p-pop-btn">
            <button id="type-save-btn" title="Save" onclick="IncidentSubTypeAddEdit.saveUpdate()" class="form-control noView btn-c-primary"><i class="fa fa-save me-2"></i>Save</button>
        </div>
    </div>
</div>
