@using BL.Models.Activities;
@model ActivitiesDTO;

<div id="Activities-AddEdit-Panel">

    <div class="form-panel">

        @*Id HIDDEN*@
        <div class="form-floating d-none">
            <span></span>
            @Html.TextBoxFor(m => m.Id, new { @class = "form-control", @result = "Id", @id = "Id", @type = "number", @placeholder = "Id" })
        </div>
        @*MId HIDDEN*@
        <div class="form-floating d-none">
            <span></span>
            @Html.TextBoxFor(m => m.MId, new { @class = "form-control", @result = "MId", @id = "MId", @type = "text", @placeholder = "MId" })
        </div>
        @*TaskList*@
        <div class="form-floating">
            @Html.HiddenFor(m => m.ActivityTypeId, new { @id = "select-tasklist-id" })
            <select class="form-select" id="select-tasklist" name="TaskList" Result="ActivityTypeId" required>
                <option value=""></option>
            </select>
            <label for="select-tasklist" class="label-required">Activity Type</label>
        </div>

        @*StartDate*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @result = "StartDate", @id = "StartDate", @type = "date", @placeholder = "StartDate"})
            <label class="">Start Date</label>
        </div>

        @*EndDate*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @result = "EndDate", @id = "EndDate", @type = "date", @placeholder = "EndDate" })
            <label class="">End Date</label>
        </div>

        @*Status*@
        <div class="form-floating">
            @Html.HiddenFor(m => m.Status, new { @id = "select-status-id" })
            <select class="form-select" id="select-status" name="Status" Result="Status" required>
                <option value=""></option>
            </select>
            <label for="select-status" class="label-required">Status</label>
        </div>

        @*Dynamic Elements*@
        <div id="dynamicElements" class="w-100">
        </div>

        @*User*@
        <div class="form-floating">
            @Html.HiddenFor(m => m.User, new { @id = "select-user-id" })
            <select class="form-select" id="select-user" name="User" Result="User" required>
                <option value=""></option>
            </select>
            <label for="select-user" class="label-required">User</label>
        </div>

        @*Remarks*@
        <div class="form-floating short-input">
            @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control textarea-floating", @result = "Remarks", @id = "Remarks", @type = "text", @placeholder = "Remarks" })
            <label class="label-textarea-floating">Remarks</label>
        </div>

    </div>

    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 pe-5 row">
            @if (Model != null && Model.URL != string.Empty)
            {
                <button id="show-link-to-schem-btn" onclick="ActivitiesAddEdit.redirect('@Model.URL.ToString()')" title="View" class="form-control btn-c-secondary me-3"><i class="fa fa-eye me-2"></i>View</button>
            }
            <button id="value-save-btn" title="Save" onclick="ActivitiesAddEdit.saveUpdate()" class="form-control btn-c-primary"><i class="fa fa-save me-2"></i>Save</button>
        </div>
    </div>
</div>
