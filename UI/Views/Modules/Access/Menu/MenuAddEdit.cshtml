@using BL.Models.Access;
@model SideMenuDTO;

<div id="Menu-AddEdit-Panel">
    <div class="form-panel">

        @*Menu Id HIDDEN*@
        <div class="form-floating d-none">
            @Html.TextBoxFor(m => m.Id, new { @class="form-control",@result="Id", @id = "Id", @type = "text", @placeholder = "Id"})
        </div>

        @*Menu Display Name*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.DisplayName, new { @class="form-control",@result="DisplayName", @id = "DisplayName", @type = "text", @placeholder = "Display Name" })
            <label class="label-floating label-required">Display Name</label>
        </div>

        @*Menu Icon*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Icon, new { @class="form-control",@result="Icon", @id = "Icon", @type = "text", @placeholder = "Icon"})
            <label class="label-floating label-required">Icon</label>
            <span class="naveo-color span-smaller"><a href="https://fontawesome.com/v6/search?o=r&m=free" target="_blank" class="span-smaller"> Click To Access Icon Library. </a></span>
        </div>

        @*Menu Preview*@
       @* <div class="mt-4 w-100">
            <label for="tree" class="mb-2"> Icon Preview </label>
            <div id="icon-preview"></div>
        </div>*@

        @*Menu Order*@
        <div class="form-floating">
            @Html.TextBoxFor(m => m.Order, new { @class="form-control",@result="Order", @id = "Order", @type = "number", @placeholder = "Order"})
            <label class="label-floating label-required">Order</label>
        </div>

    </div>

    @*Save Action*@
    <div>
        <div class="justify-content-end my-3 pe-5 row">
            <button id="value-save-btn" title="Save" onclick="MenuAddEdit.saveUpdate()" class="form-control noView btn-c-primary"><i class="fa fa-save me-2"></i>Update</button>
        </div>
    </div>
</div>
