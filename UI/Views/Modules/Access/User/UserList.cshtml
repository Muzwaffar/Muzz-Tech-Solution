@{
    Layout = "~/Views/Shared/_LayoutCustom.cshtml";
    ViewData["Title"] = "User";
}
@using System.Globalization;
@using DAL.Models;
@model ApplicationUser;


@*Main Container*@
<div id="">
    @*Breadcrumb*@
    <div class="breadcrumb-container d-flex">
        <div class="breadcrumb-sub-container">
            <span class="span-larger"><i class="fa-regular fa-circle-user me-2 fa-1x"></i> User </span>
            <a href="#" role="button" aria-expanded="false"><i class="fa fa-ellipsis-vertical fa-20 ms-2"></i></a>
            <div class="dropdown-context">
            </div>

        </div>
        <div class="section-container d-flex">
        </div>
    </div>


    @*Datatable*@
    <table id="UserTable"></table>

</div>

@*Partial View*@
<div id="partial" class="overlay-partial">
    <div class="popup">
        <div class="title">
            <span class="span-large"><i class="fa fa-user-cog me-2"></i>User</span>
            <a class="close" href="#"><i class="fa fa-close"></i></a>
        </div>
        <div class="content">
        </div>
    </div>
</div>

@*References*@
@section Scripts{
    <script src="~/Scripts/Modules/Access/User/User.js" type="module"></script>
    <script src="~/Scripts/Modules/Access/User/UserAddEdit.js" type="module"></script>
   
}
