@{
    ViewData["Title"] = @ViewBag.Name;
    Layout = "~/Views/Shared/_LayoutCustom.cshtml";
}

@*Model Used *@
@using BL.Models.Workflow;
@model WorkflowMappingCruDTO;

@*Top nav bar Start*@
<div id="">
    @*Top nav bar Container*@
    <div class="breadcrumb-container d-flex">
        @*Breadcrumb - Left *@
        <div class="breadcrumb-sub-container">
            @*Breadcrumb : Text *@
            <span class="span-larger"> @ViewBag.Name </span>
            @*Breadcrumb : Action *@
            <a href="#" role="button" aria-expanded="false"><i class="fa fa-ellipsis-vertical fa-20 ms-2"></i></a>
            @*Breadcrumb : Dropdown *@
            <div class="dropdown-context">
            </div>
        </div>
        @*Section - Right *@
        <div class="section-container d-flex">
            @*Section Nav : container *@
            <nav>
                <div class="nav nav-pill" id="nav-tab" role="tablist">
                    @*Section Nav Item: Form Info *@
                    @*IMPORTANT : id  ,target, controls, active class *@
                    <button class="nav-link active section-menu" id="WorkflowMapping-tab" data-bs-toggle="pill" data-bs-target="#details-WorkflowMapping" type="button" role="tab" aria-controls="details-WorkflowMapping" aria-selected="true">
                        <span class="span-medium">
                            @*Section Item: Icon for Status *@
                            <i class="fa fa-circle-dot me-2"></i>
                            @*Section Item: Text *@
                            General Information
                        </span>
                    </button>

                </div>
            </nav>
        </div>
    </div>
</div>
@*Top nav bar End*@

@*Main Container Start*@
@*IMPORTANT : id to retrieve data to send to api  *@
<div class="tab-content " id="workflow-mapping">
    @*Main Container scrollspy : Form Info*@
    <div class="tab-pane fade show active" id="details-WorkflowMapping" role="tabpanel" aria-labelledby="WorkflowMapping-tab">
        @*scrollspy*@
        <div class="row content-scrollspy">
            @*scrollspy content*@
            <div class="col-10 content-form">
                <div id="AddEdit-Panel" class="content-panel" data-bs-spy="scroll" data-bs-target="#scrollspy-menu-Form" data-bs-offset="0" data-bs-smooth-scroll="true" tabindex="0">
                    @*scrollspy sub section*@
                    <div id="scrollspy-header" class="scrollspy-transition">
                        @*sub section Header*@
                        <div class="section" data-bs-toggle="collapse" href="#header" aria-expanded="true">
                            <span class="span-medium"> Header </span>
                            <span class="collapsible-icon"></span>
                        </div>
                        @*sub section Content*@
                        <div class="collapse form-panel show" id="header">

                            @*Code*@
                            <div class="form-floating">
                                @Html.TextBoxFor(m => m.Code, new { @class = "form-control", @id = "Code", @type = "text", @placeholder = "Code", @readonly="true"})
                                <label>Code</label>
                            </div>

                            @*Name*@
                            <div class="form-floating">
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @id = "Name", @type = "text", @placeholder = "Name", @result = "Name" })
                                <label class ="label-required">Name</label>
                            </div>

                            @*Sequence*@
                            <div class="form-floating d-none">
                                @Html.TextBoxFor(m => m.Sequence, new { @class = "form-control", @id = "Sequence", @type = "number", @placeholder = "Sequence", @result = "Sequence" })
                                <label class="label-required">Sequence</label>
                            </div>

                            @*Module*@
                            <div class="form-floating">
                                @Html.HiddenFor(m => m.ModuleId, new { @id = "select-ModuleId-id" })
                                <select class="form-select" id="select-ModuleId" name="ModuleId" result="ModuleId">
                                    <option value=""></option>
                                </select>
                                <label for="select-ModuleId" class="label-required">Module</label>
                            </div>

                            @*WFType*@
                            <div class="form-floating">
                                @Html.HiddenFor(m => m.WFType, new { @id = "select-WFType-id" })
                                <select class="form-select" id="select-WFType" name="WFType" result="WFType">
                                    <option value=""></option>
                                </select>
                                <label for="select-WFType" class="label-required">Workflow Type</label>
                            </div>

                            @*CaseStatus*@
                            <div class="form-floating d-none">
                                @Html.HiddenFor(m => m.CaseStatus, new { @id = "select-CaseStatus-id" })
                                <select class="form-select" id="select-CaseStatus" name="CaseStatus" result="CaseStatus">
                                    <option value=""></option>
                                </select>
                                <label for="select-CaseStatus" class="label-required">Case Status</label>
                            </div>

                            @*Attribute Type*@
                            <div class="form-floating">
                                @Html.HiddenFor(m => m.AttributeType, new { @id = "select-AttributeType-id" })
                                <select class="form-select" id="select-AttributeType" name="AttributeType" result="AttributeType">
                                    <option value=""></option>
                                </select>
                                <label for="select-AttributeType" class="label-required">Attribute Type</label>
                            </div>

                        </div>
                    </div>

                    <div id="scrollspy-details" class="scrollspy-transition d-none">
                        @*sub section Header*@
                        <div class="section" data-bs-toggle="collapse" href="#Detail" aria-expanded="true">
                            <span class="span-medium"> Details </span>
                            <span class="collapsible-icon"></span>
                        </div>
                        @*sub section Content*@
                        <div class="collapse form-panel show" id="Detail">
                            @*Name *@
                            <div class="form-floating">
                                <input type="text" class="form-control" id="dName" placeholder="Name" />
                                <label>Name</label>
                            </div>

                            @*Sequence *@
                            <div class="form-floating">
                                <input type="number" class="form-control" id="dSequence" placeholder="Sequence" />
                                <label>Sequence</label>
                            </div>

                            @*Description*@
                            <div class="form-floating">
                                <input type="text" class="form-control" id="dDescription" placeholder="Description" />
                                <label>Description</label>
                            </div>

                            @*Module*@
                            <div class="form-floating">
                                <select class="form-select" id="select-dModuleNext" name="module">
                                    <option value=""></option>
                                </select>
                                <label for="select-dModuleNext">Next Screen Name</label>
                            </div>

                            @*URLName*@
                            <div class="form-floating">
                                <input type="text" class="form-control" id="dURLName" placeholder="URLName"  readonly/>
                                <label>URL Name</label>
                            </div>

                            @*CaseStatus*@
                            <div class="form-floating">
                                <select class="form-select" id="select-dCaseStatus" name="dCaseStatus">
                                    <option value=""></option>
                                </select>
                                <label for="select-dCaseStatus">CaseStatus</label>
                            </div>

                            @*AType*@
                            <div class="form-floating">
                                <select class="form-select" id="select-aType" name="aType">
                                    <option value=""></option>
                                </select>
                                <label for="select-aType">AType</label>
                            </div>

                            @*WFType*@
                            <div class="form-floating">
                                <select class="form-select" id="select-dwfType" name="wfType">
                                    <option value=""></option>
                                </select>
                                <label for="select-dwfType">Workflow Type</label>
                            </div>

                            @*ActivityType*@
                            <div class="form-floating">
                                <select class="form-select" id="select-activity-type" name="activity-type">
                                    <option value=""></option>
                                </select>
                                <label for="select-activity-type">Activity Type</label>
                            </div>

                            @*ModuleCurrent*@
                            <div class="form-floating">
                                <select class="form-select" id="select-dModuleCurrent" name="ModuleCurrent">
                                    <option value=""></option>
                                </select>
                                <label for="select-dModuleCurrent">Current Module</label>
                            </div>

                            @*FormSequence *@
                            <div class="form-floating">
                                <input type="number" class="form-control" id="dFormSequence" placeholder="Form Sequence" />
                                <label>Form Sequence</label>
                            </div>

                            @*Message *@
                            <div class="form-floating">
                                <input type="text" class="form-control" id="message" placeholder="Message" />
                                <label>Message</label>
                            </div>

                            @*Add Data To Table*@
                            <button id="value-addT-btn" title="Add" onclick="WorkflowMappingAddEdit.addDataElement()" class="btn-c-primary form-control mt-4 w-100"><i class="fa fa-plus me-2"></i>Add Data To Table</button>

                            @*Element Table*@
                            <div class="w-100">
                                <table id="ElementTable"></table>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
            @*scrollspy action*@
            <div class="col-2 scrollspy-con scrollspy" id="scrollspy-menu-Form">
                @*scrollspy action : Header*@
                <span class="naveo-color m-3"> Sections </span>
                @*scrollspy actions content*@
                <div class="scrollspy-content">
                    @*scrollspy actions item*@
                    <div class="m-3">
                        <a href="#scrollspy-header">
                            <span class="span-medium">Header</span>
                        </a>
                    </div>
                    @*scrollspy actions item*@
                    <div class="m-3 d-none" id="section-details">
                        <a href="#scrollspy-details">
                            <span class="span-medium">Detail</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*Main Container End*@

@*Actions*@
<div class="row action-bar">
    <button id="value-back-btn" title="Back" onclick="WorkflowMappingAddEdit.back()" class="form-control btn-c-error me-3"><i class="fa fa-chevron-left me-2"></i>Back</button>
    <button id="value-save-btn" title="Save" onclick="WorkflowMappingAddEdit.save()" class="form-control noView btn-c-primary me-3"><i class="fa fa-save me-2"></i>Save</button>

</div>

@section Scripts {
    <script src="~/Scripts/Modules/Workflow/WorkflowMapping/WorkflowMappingAddEdit.js" type="module"></script>
}