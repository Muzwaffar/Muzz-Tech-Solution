@*Partial View Approval Start*@

@*Actions*@
<div class="row action-bar">
    <button id="value-back-btn" title="Back" onclick="FormPageAddEdit.back()" class="form-control btn-c-error me-3"><i class="fa fa-chevron-left me-2"></i>Back</button>
    @if (Model.GeneralStatus == DAL.Common.GeneralStatus.Open)
    {

        @if (Model == null || Model.Approval == DAL.Common.ApprovalStatus.Draft || Model.Approval == DAL.Common.ApprovalStatus.Saved || Model.Approval == DAL.Common.ApprovalStatus.None)
        {
            <button id="value-draft-btn" title="Save" onclick="FormPageAddEdit.save(1)" class="form-control noView btn-c-secondary me-3"><i class="fa fa-save me-2"></i>Save As Draft</button>
            <button id="value-save-btn" title="Save" onclick="FormPageAddEdit.save(11)" class="form-control noView btn-c-primary me-3"><i class="fa fa-save me-2"></i>Submit</button>
        }
        else
        {
            @if (Model.ApprovalS == DAL.Common.ApprovalStatus.None)
            {
                <button id="value-draft-btn" title="Save" onclick="FormPageAddEdit.save(1)" class="form-control noView btn-c-secondary me-3"><i class="fa fa-save me-2"></i>Save As Draft</button>
                <button id="value-save-btn" title="Save" onclick="FormPageAddEdit.save(11)" class="form-control noView btn-c-primary me-3"><i class="fa fa-save me-2"></i>Submit</button>

            }
        }


    }
    @if (Model.GeneralStatus != DAL.Common.GeneralStatus.Open)
    {
        @if (Model != null)
        {
            @if (Model.Approval == DAL.Common.ApprovalStatus.AwaitingApproval && Model.IsApprover == true)
            {
                <button id="value-approve-btn" title="Decline" onclick="FormPageAddEdit.approval(2)" class="form-control btn-c-info me-3"><i class="fa fa-save me-2"></i>Decline</button>
                <button id="value-decline-btn" title="Approve" onclick="FormPageAddEdit.approval(1)" class="form-control btn-c-primary me-3"><i class="fa fa-save me-2"></i>Approve</button>
            }
            @if (Model.Approval == DAL.Common.ApprovalStatus.Approved || Model.Approval == DAL.Common.ApprovalStatus.Declined || (Model.Approval == DAL.Common.ApprovalStatus.AwaitingApproval && Model.IsApprover == false))
            {
                <span id="statusText" class="mx-3 span-large w-auto
                @(Model.Approval == DAL.Common.ApprovalStatus.AwaitingApproval ? "naveo-color-orange" :
                    Model.Approval == DAL.Common.ApprovalStatus.Approved ? "naveo-color-green" :
                    Model.Approval == DAL.Common.ApprovalStatus.Declined ? "naveo-color-red" :
                    "")">
                    @Model.Approval
                </span>
            }
            @if (Model.Status == DAL.Common.Status.Rework)
            {
                <span id="statusText" class="mx-3 span-large w-auto
                  @("naveo-color-orange")">
                    @Model.Status
                </span>
            }
        }
        @*         else
    {
    <span id="statusText" class="mx-3 span-large w-auto
    @(Model.GeneralStatus == DAL.Common.GeneralStatus.Inprogress ? "naveo-color-orange" :
    Model.GeneralStatus == DAL.Common.GeneralStatus.Completed ? "naveo-color-green" :
    Model.GeneralStatus == DAL.Common.GeneralStatus.Closed ? "naveo-color-red" :
    "")">
    @Model.GeneralStatus
    </span>
    }   *@
    }
</div>

@section Scripts {
    <script src="~/Scripts/Modules/FormPage/FormPageAddEdit.js" type="module"></script>
    <script src="~/Scripts/Modules/Common/ApprovalService.js" type="module"></script>
}
